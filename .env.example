# MySQL
MYSQL_ROOT_PASSWORD=change-me-root

AUTH_DB_URL=jdbc:mysql://localhost:3306/auth_db?useSSL=false&allowPublicKeyRetrieval=true
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth
COURSE_DB_URL=jdbc:mysql://localhost:3306/course_db?useSSL=false&allowPublicKeyRetrieval=true
COURSE_DB_USER=course_user
COURSE_DB_PASSWORD=change-me-course
PAYMENT_DB_URL=jdbc:mysql://localhost:3306/payment_db?useSSL=false&allowPublicKeyRetrieval=true
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me-notification

# Redis (no password in dev)
# REDIS_HOST=redis

# Kafka
# Host listener of the dev broker. Applications running outside Docker use localhost:29092;
# containers on the compose network use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Bounded producer timeouts in milliseconds, so an unreachable broker never blocks a request or an
# outbox tick for long. The service defaults are already short; override only for experiments.
# KAFKA_PRODUCER_MAX_BLOCK_MS=3000
# KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=3000
# KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=6000

# Management port override for running several services from the IDE
MANAGEMENT_SERVER_PORT=9090

# payment-service
# course-service is the only source of the amount, title and currency.
COURSE_SERVICE_URL=http://localhost:8082
# Root of the local receipt storage; data/ is git-ignored.
RECEIPTS_DIR=./data/receipts

# JWT keys (generated by scripts/gen-jwt-keys.sh)
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# Platform bootstrap (created by auth-service on first start)
PLATFORM_TENANT_SLUG=platform
PLATFORM_TENANT_NAME=Platform
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_NAME=Platform Admin
# The example placeholder is rejected outside the dev profile.
PLATFORM_ADMIN_PASSWORD=change-me-admin

# Demo seed (only active with the "demo" profile). Never use this placeholder outside local demos.
DEMO_PASSWORD=change-me-demo
