# Target of the Vite dev server proxy. The browser keeps the same origin, so the
# gateway sees the tenant host unchanged (Host header) and the forwarded client IP.
VITE_API_TARGET=http://localhost:8080

# Base domain used to read the tenant slug from the hostname. With the value
# below, atlas.localhost and acme.localhost select those tenants.
VITE_BASE_DOMAIN=localhost

# Optional example: preselect a tenant when neither the hostname nor ?tenant=
# provides one. Leave it commented (or empty) to show the organisation picker on
# a plain http://localhost:5173.
# VITE_DEFAULT_TENANT=atlas
